    bool hasCode(ulong code) => false;

    ComResult render(
        ComSurface targetSurface,
        const(dchar[]) text,
        ubyte fr = 0, ubyte fg = 0, ubyte fb = 0, ubyte fa = 255,
        ubyte br = 0, ubyte bg = 0, ubyte bb = 0, ubyte ba = 255,
        float alphaGamma, ComFontRenderMode mode) nothrow
    {
        const size = 8;

        uint scaleX = 1;
        uint scaleY = 2;

        const newW = size * scaleX;
        const newH = size * scaleY;
        if (const err = targetSurface.createRGBA32(cast(int) newW, cast(int) newH))
        {
            return err;
        }

        size_t idx = cast(size_t) text[0];
        if (idx >= 128)
        {
            idx = 63;
        }

        if (const err = targetSurface.fill(0, 0, 0, 0))
        {
            return err;
        }

        immutable(uint[8])* glyph = &font[idx];

        foreach (uint y; 0 .. size)
        {
            uint rowByte = (*glyph)[y];
            foreach (uint x; 0 .. size)
            {
                if (rowByte & (0x80 >> x))
                {
                    foreach (uint dy; 0 .. scaleY)
                    {
                        foreach (uint dx; 0 .. scaleX)
                        {
                            auto pixelX = (x * scaleX) + dx;
                            auto pixelY = (y * scaleY) + dy;

                            uint* pixelPtr;
                            if (targetSurface.getPixel(cast(int) pixelX, cast(int) pixelY, pixelPtr))
                            {
                                targetSurface.setPixel(pixelPtr, fr, fg, fb, fa);
                            }
                        }
                    }
                }
            }
        }

        return ComResult.success;
    }

    string getFontPath() nothrow => _path;
    uint getFontSize() nothrow => _size;
    uint getMaxHeight() nothrow => _maxHeight;

    bool dispose() nothrow
    {
        _path = null;
        return true;
    }

    bool isDisposed() pure nothrow @safe => _path is null;
